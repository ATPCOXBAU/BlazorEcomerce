@page "/product/{Id:int}"
@inject IProductService productService
@inject ICartService CartService

@if (product == null)
{
    <div class="container">
        <div class="loader"></div>
    </div>
}
else
{
    <div class="container">
        <div class="card">
            <div class="text">
                <h2>@product.Title</h2>
            </div>
            <div class="middle_container">
                <div class="image-container">
                    <img src="@product.ImageUrl" alt="@product.Title">
                </div>
                <div class="text">
                    <h4>@product.Description</h4>
                </div>
            </div>
            <div class="product-price">$@((product.Price ?? 0).ToString("F2"))</div>
            @if (IsinCart)
            {
                <button class="in-cart-btn" disabled>Already in cart</button>
            }
            else
            {
                <button class="button-9" @onclick="AddToCart">
                    Add to Cart
                </button>
            }
        </div>
    </div>
    <ShoppingCart />
}

@code {
    private Product? product;
    [Parameter]
    public int Id { get; set; }
    private bool IsinCart = false;

    private async Task AddToCart()
    {
        if (product == null) return;
        await CartService.AddToCart(product);
        IsinCart = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        var result = await productService.GetProductById(Id);
        if (result.Success && result.Data != null)
        {
            product = result.Data;
            IsinCart = await CartService.IsInCart(product.Id);
        }
    }
}
