<header class="top-navbar">
    <div class="navbar-inner">
        <a class="brand" href="">ECPR</a>

        <div class="search-box">
            <span class="oi oi-magnifying-glass search-icon"></span>
            <input type="text" placeholder="Search products..."
                   @bind="searchText"
                   @bind:event="oninput"
                   @onkeydown="HandleSearch" />
        </div>

        <button title="Navigation menu" class="navbar-toggle" @onclick="ToggleNavMenu">
            <span class="oi oi-menu"></span>
        </button>

        <nav class="nav-links @NavMenuCssClass">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                Home
            </NavLink>
            <NavLink class="nav-link" href="categories">
                Categories
            </NavLink>
            <NavLink class="nav-link" href="cartview">
                <span class="oi oi-cart"></span> Cart
            </NavLink>
        </nav>
    </div>
</header>

@code {
    [Inject] private NavigationManager NavigationManager { get; set; }

    private bool collapseNavMenu = true;
    private string searchText = "";

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void HandleSearch(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchText))
        {
            NavigationManager.NavigateTo($"/search/{searchText}");
        }
    }
}
