@page "/category/{catId:int}"
@inject ICategoryService categoryService

@if (isLoading)
{
    <div class="loading-state">
        <div class="loader"></div>
    </div>
}
else if (errorMessage != null)
{
    <p>@errorMessage</p>
}
else if (products.Count == 0)
{
    <h2>No products for this category</h2>
}
else
{
    <ProductList CurrentCategory="products" />
}

@code {
    private List<Product> products = new();
    private string? errorMessage;
    private bool isLoading = true;

    [Parameter]
    public int CatId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;

        var result = await categoryService.GetProductsByCategory(CatId);
        if (result == null || !result.Success)
        {
            errorMessage = result?.Message ?? "Failed to load products.";
        }
        else
        {
            products = result.Data ?? new();
        }

        isLoading = false;
    }
}
