@page "/categories"
@inject ICategoryService categoryService
@inject NavigationManager NavigationManager

<div class="listContainer">
    <h1>Categories</h1>

    <div class="list mt-5">
        <ul>
        @foreach (Category cat in categoryService.Categories)
        {
            <li><a @onclick="@(() => NavigateToCategory(cat.CategoryId))"><span>@(cat.CategoryName?.ToUpperInvariant())</span></a></li>
        }
        </ul>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await categoryService.GetCategories();
    }

    private void NavigateToCategory(int categoryId)
    {
        NavigationManager.NavigateTo($"/category/{categoryId}");
    }
}
